# --- Allgemein ---
APP_NAME=SubSplit
# Öffentliche URL (für Einrichtungslinks), ohne Slash am Ende
BASE_URL=https://abos.example.org
TZ=Europe/Berlin

# --- Geheimnisse (zwei verschiedene Werte, je mindestens 32 Zeichen: openssl rand -hex 32) ---
# Signiert die Sitzungen.
SESSION_SECRET=
# Verschlüsselt die GANZE Datenbankdatei. ACHTUNG: Geht dieser Schlüssel verloren, sind alle Daten unwiederbringlich
# weg. Sichere ihn getrennt von der Datenbank und den Backups (z. B. im Passwortmanager) und ändere ihn nie im Betrieb.
DB_ENCRYPTION_KEY=

# Benutzer, Empfängerdaten (IBAN, PayPal.Me) und Fälligkeitstag liegen NICHT mehr hier, sondern pro Konto
# in der App (Einstellungen). Das erste Konto ("admin", Betreiber) richtest du über den Einrichtungslink ein,
# den die App beim ersten Start ins Log schreibt: docker compose logs subsplit

# --- Betrieb ---
# Wer ohne Aktion nach so vielen Minuten abgemeldet wird (1-1440, Standard 30)
# ADMIN_IDLE_TIMEOUT_MINUTES=30
DATABASE_PATH=/data/subsplit.db
SECURITY_LOG_FILE=/logs/security.log
# Adressbereich des Docker-Netzwerks, in dem Caddy läuft (kommagetrennt). X-Forwarded-For
# wird nur von dort akzeptiert. Beispiel: 172.18.0.0/16
TRUSTED_PROXY_CIDR=
# Name des externen Docker-Netzwerks von Caddy (docker-compose.yml)
PROXY_NETWORK=proxy

# --- Einladungen: wer darf Einladungslinks erstellen und wie viele gleichzeitig offen (je 7 Tage gültig) ---
# all = jedes Konto, operator = nur der Betreiber (wirkt sofort, auch auf bereits erstellte Links anderer)
# INVITATIONS_CREATORS=all
# Offene Links pro Konto gleichzeitig (0-100, Standard 5; 0 = Einladungen ganz abgeschaltet)
# INVITATIONS_MAX_ACTIVE=5

# --- Warnung bei ungewöhnlich hoher Monatssumme eines Empfängers (nur Betreiber sieht die Warnung) ---
# UNUSUAL_MONTHLY_TOTAL_EUR=500   # fester Schwellenwert
# UNUSUAL_FACTOR=3                # oder mehr als das X-Fache des Durchschnitts der letzten 3 Monate

# --- PayPal-Linkformat (nur ändern, wenn der Link auf dem Handy nicht wie gewünscht aufgeht) ---
# Das Format ist nicht vollständig belegt; Varianten mit einem Kleinstbetrag auf echten Geräten testen.
# PAYPAL_LINK_BASE=https://paypal.me                 # Standard; alternativ https://www.paypal.com/paypalme
# PAYPAL_APPEND_CURRENCY=false                       # true = "EUR" an den Betrag hängen (Standard: nein)
# PAYPAL_DECIMAL=comma                               # Standard (z. B. 12,34); alternativ dot

# --- E-Mail (optional): Erinnerungen, Preisänderungen, Adress-Bestätigung ---
# Ohne SMTP_HOST verschickt die App keine E-Mails. Anleitung: README, Abschnitt "E-Mail".
# Variante 1: mitgelieferter Mail-Container (docker compose --profile mail up -d), kein Fremdanbieter:
# SMTP_HOST=mail
# SMTP_SECURITY=internal
# MAIL_FROM=SubSplit <noreply@anfall.net>
# MAIL_DOMAIN=anfall.net            # nur für den Mail-Container
# MAIL_HOSTNAME=mail.anfall.net     # nur für den Mail-Container, muss zum PTR-Eintrag passen
# Variante 2: ein anderer SMTP-Server (Hoster, Relay):
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587                     # Standard: 587 (starttls) bzw. 465 (tls)
# SMTP_SECURITY=starttls            # starttls | tls | internal
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=SubSplit <noreply@anfall.net>
# Rhythmus der Zahlungserinnerungen
# REMINDER_FIRST_DAYS_AFTER_DUE=3   # erste Erinnerung X Tage nach dem Fälligkeitstag (0-28)
# REMINDER_REPEAT_DAYS=7            # danach frühestens alle X Tage (1-60)
# REMINDER_MAX_PER_PAYMENT=3        # höchstens X Erinnerungen pro Monatszahlung (1-10)
