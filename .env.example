# --- Allgemein ---
APP_NAME=SubSplit
# Öffentliche URL (für Magic-Links), ohne Slash am Ende
BASE_URL=https://abos.example.org
TZ=Europe/Berlin

# --- Admin ---
ADMIN_USERNAME=admin
# Hash des Passworts, erzeugen mit: docker run --rm -it subsplit:latest node scripts/hash-password.mjs
# (Format ohne "$", damit docker compose nichts interpoliert.)
ADMIN_PASSWORD_HASH=
# Mindestens 32 zufällige Zeichen, z. B.: openssl rand -hex 32
SESSION_SECRET=
# Admin wird nach so vielen Minuten ohne Aktion abgemeldet (1-1440, Standard 30)
# ADMIN_IDLE_TIMEOUT_MINUTES=30

# --- Empfänger (du) ---
RECIPIENT_NAME=Vorname Nachname
# Nur der Name nach paypal.me/ (Buchstaben und Ziffern)
RECIPIENT_PAYPAL_ME=
RECIPIENT_IBAN=DE89 3704 0044 0532 0130 00
# Optional: Format des PayPal-Links (nur ändern, wenn der Link auf dem Handy nicht wie gewünscht aufgeht).
# Das Format ist nicht vollständig belegt; Varianten mit einem Kleinstbetrag auf echten Geräten testen.
# PAYPAL_LINK_BASE=https://paypal.me                 # Standard; alternativ https://www.paypal.com/paypalme
# PAYPAL_APPEND_CURRENCY=false                       # true = "EUR" an den Betrag hängen (Standard: nein)
# PAYPAL_DECIMAL=comma                              # Standard (z. B. 12,34); alternativ dot
# Fälligkeitstag im Monat (1-28)
DUE_DAY=1

# --- Betrieb ---
DATABASE_PATH=/data/subsplit.db
SECURITY_LOG_FILE=/logs/security.log
# Adressbereich des Docker-Netzwerks, in dem Caddy läuft (kommagetrennt). X-Forwarded-For
# wird nur von dort akzeptiert. Beispiel: 172.18.0.0/16
TRUSTED_PROXY_CIDR=
# Name des externen Docker-Netzwerks von Caddy (docker-compose.yml)
PROXY_NETWORK=proxy

# --- Phase 2 (noch nicht aktiv) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
